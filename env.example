# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и впишите свои ключи.
# Файл .env никому не показывайте и не кладите в git.
# ---------------------------------------------------------------------------

# 1) Copernicus Data Space Ecosystem — бесплатные снимки Sentinel-2.
#    Регистрация: https://dataspace.copernicus.eu  ->  Sentinel Hub Dashboard
#    -> User settings -> OAuth clients -> Create. Получите ID и Secret.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 2) NASA FIRMS — бесплатные данные о тепловых аномалиях (факелы, пожары).
#    Ключ выдаётся мгновенно по e-mail:
#    https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# 3) AISStream.io — бесплатный поток AIS (позиции судов).
#    Регистрация через GitHub-аккаунт: https://aisstream.io
AISSTREAM_API_KEY=

# 4) Telegram — куда присылать отчёты. Необязательно.
#    Бота создаёте у @BotFather, chat_id узнаёте у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5) Lusha — контакты лиц, принимающих решения. Необязательно.
#    Ключ: lusha.com -> вход -> API & connectors -> создать ключ.
#    ВНИМАНИЕ: платный по действиям. На бесплатном тарифе 40 кредитов,
#    поиск 1 кредит за 25 найденных, раскрытие почты 1 за человека,
#    телефона — 5. В ежедневный цикл НЕ входит, тратится только по
#    вашей команде: python bot.py contacts
LUSHA_API_KEY=

# 6) Проверка снимков зрячей моделью. Необязательно, но полезно:
#    код считает пиксели, модель видит смысл. Достаточно ЛЮБОГО
#    одного ключа — бот пробует их по очереди: Gemini, затем Grok,
#    затем Claude.
#    Gemini: aistudio.google.com -> Get API key
#    Grok:   console.x.ai
#    Claude: console.anthropic.com
GEMINI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
