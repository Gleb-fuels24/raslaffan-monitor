@echo off
REM ---------------------------------------------------------------------
REM Ежедневный запуск монитора Ras Laffan.
REM Этот файл вызывается Планировщиком заданий Windows.
REM Запускать вручную не нужно — но можно, чтобы проверить, что работает.
REM ---------------------------------------------------------------------

REM Переходим в папку, где лежит этот файл. %~dp0 — путь к нему.
cd /d "%~dp0"

REM Записываем вывод в журнал: если запуск ночью упадёт, утром будет видно
REM почему. Файл перезаписывается каждый день, чтобы не рос бесконечно.
set LOGDIR=data\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ===================================================== >> "%LOGDIR%\daily.log"
echo Запуск: %date% %time% >> "%LOGDIR%\daily.log"

python bot.py publish >> "%LOGDIR%\daily.log" 2>&1

if errorlevel 1 (
    echo [ОШИБКА] Код возврата %errorlevel% >> "%LOGDIR%\daily.log"
) else (
    echo Готово: %date% %time% >> "%LOGDIR%\daily.log"
)
